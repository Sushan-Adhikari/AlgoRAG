# AlgoRAG Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Embedding Backend Configuration
# ============================================
# Options: "local", "gemini", "openai"
# Recommendation: Use "local" (FREE, works offline)
EMBED_BACKEND=local

# API Keys (Optional - only needed if using cloud backends)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Vector Database Configuration
# ============================================
# Options: "chroma", "qdrant"
# Recommendation: Use "chroma" (simple, local)
VECTOR_DB_TYPE=chroma

# ============================================
# Retrieval Configuration
# ============================================
# Number of documents to retrieve
TOP_K=5

# Minimum similarity threshold (0-1)
SIMILARITY_THRESHOLD=0.5

# ============================================
# Generator (LLM) Configuration
# ============================================
# Model options:
# - gemini-2.0-flash-exp (fast, good quality)
# - gemini-2.0-flash-thinking-exp-01-21 (slower, better reasoning)
# - gpt-3.5-turbo (OpenAI)
# - gpt-4 (OpenAI, best quality)
GENERATOR_MODEL=gemini-2.0-flash-exp

# Temperature (0-1): lower = more focused, higher = more creative
GENERATOR_TEMPERATURE=0.3

# Maximum tokens in response
GENERATOR_MAX_TOKENS=2048

# ============================================
# Logging
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# Cost Estimates (as of 2024)
# ============================================
# FREE:
#   - Local embeddings (sentence-transformers): $0
#   - ChromaDB: $0
#
# PAID (with free tiers):
#   - Gemini embeddings: ~$0.00003/1K chars (15 RPM free tier)
#   - Gemini generation: ~$0.075/1M tokens (free tier available)
#   - OpenAI embeddings: ~$0.00002/1K tokens
#   - OpenAI GPT-3.5: ~$0.002/1K tokens
#   - OpenAI GPT-4: ~$0.03/1K tokens
#
# RECOMMENDATION FOR STUDENTS:
#   Use local embeddings + Gemini generation (generous free tier)
