# AlgoRAG Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Embedding Backend Configuration
# ============================================
# Options: "local", "gemini", "openai"
# Recommendation: Use "local" (FREE, works offline, no API key needed)
EMBED_BACKEND=local

# HuggingFace Configuration (for local embeddings)
# These prevent authentication errors when downloading models
HF_HUB_DISABLE_TELEMETRY=1
# Leave HF_TOKEN blank - not needed for public models
# HF_TOKEN=

# ============================================
# Generator (LLM) Configuration
# ============================================
# Options: "ollama", "gemini", "openai"
# Recommendation: Use "ollama" (FREE, runs locally, no API key needed)
GENERATOR_BACKEND=ollama

# Ollama Configuration (for local LLM)
# Make sure Ollama is running: ollama serve
# Default model: llama3.1:7b (you can use any model you have pulled)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:7b

# Temperature (0-1): lower = more focused, higher = more creative
GENERATOR_TEMPERATURE=0.3

# Maximum tokens in response
GENERATOR_MAX_TOKENS=2048

# ============================================
# Cloud API Keys (Optional - only if using cloud backends)
# ============================================
# Only needed if GENERATOR_BACKEND=gemini or openai
# Leave blank if using Ollama

# Gemini API Key (get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ============================================
# Vector Database Configuration
# ============================================
# Options: "chroma", "qdrant"
# Recommendation: Use "chroma" (simple, local)
VECTOR_DB_TYPE=chroma

# ============================================
# Retrieval Configuration
# ============================================
# Number of documents to retrieve
TOP_K=5

# Minimum similarity threshold (0-1)
SIMILARITY_THRESHOLD=0.5

# ============================================
# Logging
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# RECOMMENDED SETUP FOR LOCAL/FREE USE
# ============================================
# 1. Install Ollama: https://ollama.ai/download
# 2. Pull a model: ollama pull llama3.1:7b
# 3. Start Ollama: ollama serve (runs in background)
# 4. Use this configuration:
#    EMBED_BACKEND=local
#    GENERATOR_BACKEND=ollama
#    OLLAMA_MODEL=llama3.1:7b
#
# Total Cost: $0 (completely free, runs locally)
# No API keys needed!

# ============================================
# ALTERNATIVE: Cloud-based Setup
# ============================================
# If you prefer cloud LLMs (requires API keys):
#
# Option 1 - Gemini (has free tier):
#   GENERATOR_BACKEND=gemini
#   GEMINI_API_KEY=your_key_here
#   Cost: Free tier available, then ~$0.075/1M tokens
#
# Option 2 - OpenAI (paid only):
#   GENERATOR_BACKEND=openai
#   OPENAI_API_KEY=your_key_here
#   Cost: GPT-3.5-turbo ~$0.002/1K tokens, GPT-4 ~$0.03/1K tokens

# ============================================
# Cost Comparison
# ============================================
# FREE SETUP (Recommended for students/researchers):
#   - Local embeddings (sentence-transformers): $0
#   - Ollama LLM (llama3.1, mistral, etc.): $0
#   - ChromaDB: $0
#   Total: $0/month
#
# CLOUD SETUP:
#   - Local embeddings: $0
#   - Gemini LLM: ~$5-10/month (with free tier)
#   - OpenAI GPT-3.5: ~$10-20/month
#   - OpenAI GPT-4: ~$50-100/month
